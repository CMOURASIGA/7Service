# 7Service - variáveis de ambiente
#
# Copie para .env.local (development) e nunca versione secrets reais.
# Cada ambiente (development/preview/production) deve ter seus próprios
# valores, isolados (docs/01-architecture/SECURITY.md).

# Público (pode chegar ao browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ENV=development

# Somente servidor - NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=development
